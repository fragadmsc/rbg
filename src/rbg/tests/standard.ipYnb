   "source": [
    "import numpy as np\n",
    "import random\n",
    "\n",
    "\n",
    "a = [random.random() for i in range(100)]\n",
    "a = np.array(a)\n",
    "\n",
    "\n",
    "mean = np.mean(a)\n",
    "var = np.var(a)\n",
    "\n",
    "nomr = (a - mean)/var\n",
    "\n",
    "print(list(nomr))\n",
    "print(list(a))"
   ]
